# AgentCanvas API environment
# Copy this file to .env locally. Never commit real credentials.

# Server
PORT=3000
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Stripe
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_your_webhook_secret
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_GROWTH=price_replace_me
STRIPE_PRICE_SCALE=price_replace_me

# AI
OPENAI_API_KEY=replace_with_your_openai_key
GOOGLE_AI_API_KEY=replace_with_your_google_ai_key
REPLICATE_API_TOKEN=replace_with_your_replicate_token

# Storage (S3 / Cloudflare R2)
AWS_ACCESS_KEY_ID=replace_with_your_access_key
AWS_SECRET_ACCESS_KEY=replace_with_your_secret_key
AWS_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET_NAME=agent-canvas-renders
S3_PUBLIC_URL=https://pub-<ID>.r2.dev

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3001
